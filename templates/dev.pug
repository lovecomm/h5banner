doctype html
html(lang="en")#H5BANNER-dev-html
	head
		title= "H5banner Development"
		meta(charset='UTF-8')
		script(src="https://code.jquery.com/jquery-3.1.1.js" integrity="sha256-16cdPddA6VdVInumRGo6IbivbERE8p7CQR3HzTBuELA=" crossorigin="anonymous")
		script(src="https://s0.2mdn.net/ads/studio/cached_libs/gsap_3.5.1_min.js")
		script.
			!{scrubber}
		style(type="text/css").
			html#H5BANNER-dev-html,
			body#H5BANNER-dev-body {
				height: 100%;
				width: 100%;
			}

			body#H5BANNER-dev-body {
				background-color: #020202;
				display: flex;
				margin: 0;
			}

			body#H5BANNER-dev-body > #nav {
				width: 250px;
				background: #353535;
				box-shadow:  0 20px #333;
				display: flex;
				flex-direction: column;
			}

			body#H5BANNER-dev-body > #nav > div > button {
				width: 100%;
				border-radius: 0;
				border: none;
				background: rgba(0, 0, 0, 0);
				color: white;
				padding: 20px 5px;
				font-size: 16px;
				border-bottom: 1px solid rgba(255, 255, 255, 0.75);
				transition: background 0.3s ease;
				outline: none !important;
				cursor: pointer;
			}

			body#H5BANNER-dev-body > #nav > div > button:first-of-type { border-top: 1px solid rgba(255, 255, 255, 0.5);}

			body#H5BANNER-dev-body > #nav > div > button.active { background: #00529c; }
			body#H5BANNER-dev-body > #nav > div > button:hover { background: #00305a; }

			body#H5BANNER-dev-body > #nav > div#title {
				text-align: center;
				color: white;
				font-size: 22px;
				text-transform: uppercase;
				padding: 40px 5px 40px;
				font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
				background: #001A31;
			}

			body#H5BANNER-dev-body > #view {
				width: calc(100% - 250px);
				display: flex;
				justify-content: center;
				flex-direction: column;
				align-items: center;
			}

			body#H5BANNER-dev-body > #view > #banner-wrapper {
				display: flex;
				flex-direction: column;
				align-items: center;
				border: 1px solid #666;
			}

			body#H5BANNER-dev-body > #view > #banner-wrapper .warning {
				max-width: 270px;
				color: black;
				background-color: rgba(255, 255, 255, 0.5);
				border: 1px solid red;
				padding: 15px;
				font-family: sans-serif;
			}

			body#H5BANNER-dev-body > #view > #scrubber {
				width: 650px;
				text-align: center;
				margin: 100px 0 0;
				position: relative;
			}
			body#H5BANNER-dev-body > #view > #filesize {
				width: 80px;
				font-family: sans-serif;
				text-align: center;
				position: absolute;
				color: white;
				top: 0;
				right: 0;
				padding: 1rem;
				background-color: #353535;
			}

	body#H5BANNER-dev-body
		div#nav
			each banner in banners
				| <div><button data-link="banners/#{banner}">#{banner.split("/")[0].split(".")[0]}</button></div>
		div#view
			div#banner-wrapper
			div#scrubber
			div#filesize
		script.
			$(document).ready(function() {
				var banners = $("#nav").find("button");
				var destination = $("#banner-wrapper");
				var scrubber = $("#scrubber");
				var filesize = $("#filesize");
				var cookie_is_set = document.cookie.match(/^(.*;)?\s*H5BANNER_current_size\s*=\s*[^;]+(.*)?$/);

				var gsaptools = null;

				function createScrubber(animation) {
					if (gsaptools) {
						gsaptools.kill();
						gsaptools = null;
						$(scrubber).empty();
					}
					gsaptools = GSDevTools.create({
						animation: animation || undefined,
						paused: false,
						globalSync: false,
						container: "#scrubber",
						minimal: false,
						persist: false,
						id: "banner-scrubber",
					});
				}

				createScrubber();

				window.getCookie = function(name) {
					match = document.cookie.match(new RegExp(name + '=([^;]+)'));
					if (match) return match[1];
				}

				if (!cookie_is_set) {
					document.cookie = "H5BANNER_current_size=" + getBannerSize(banners[0]);
					handleAjax($(banners[0]).attr("data-link"));
				} else {
					handleAjax("banners/" + getCookie("H5BANNER_current_size") + ".html");
				}

				$(banners).on("click", function() {
					$(banners).removeClass('active');
					$(this).addClass('active');
					var link = $(this).attr("data-link");
					document.cookie = "H5BANNER_current_size=" + getBannerSize(this);
					handleAjax.call(this, link);
				});

				function getBannerSize (banner) {
					return $(banner).attr("data-link").split("/")[1].split(".html")[0];
				}

				// Source: http://stackoverflow.com/questions/7718935/load-scripts-asynchronously
				function loadScript(src, callback){
					var s,
							r,
							t;
					r = false;
					s = document.createElement('script');
					s.type = 'text/javascript';
					s.src = src;
					s.onload = s.onreadystatechange = function() {
						if ( !r && (!this.readyState || this.readyState == 'complete') )
						{
							r = true;
							callback();
						}
					};
					t = document.getElementsByTagName('script')[0];
					t.parentNode.insertBefore(s, t);
				}

				var recursiveScriptLoad = function (scripts_array, callback) {
					if (scripts_array.length > 0) { // make sure there is an item in the array
						loadScript(scripts_array[0], function () {
							scripts_array.shift();
							if (scripts_array.length > 0) { // if there are more items in the array after removing the first item, recall the function, else call the callback
								recursiveScriptLoad(scripts_array, callback)
							} else {
								callback();
							}
						})
					} else {
						callback();
					}
				}

				function handleAjax (link) {
					var fileSizeTotal = 0;

					var xhr = $.ajax({
						type: "GET",
						url: link,
						dataFilter: dataFilter,
						success: function (response) {
							$(destination).text("");

							recursiveScriptLoad(response.src_scripts, function() {
								$(destination).append(response.href_styles)
								$(destination).append(response.styles);
								$(destination).append(response.markup);

								var element = document.createElement('div');
								element.innerHTML = response.markup;
								var imgSrcUrls = element.getElementsByTagName("img");

								var imgSrcArray = [];
								for (var i = 0; i < imgSrcUrls.length; i++) {
									var urlValue = imgSrcUrls[i].getAttribute("src");
									if (urlValue) {
										imgSrcArray.push(urlValue)
									}
								}

								imgSrcArray.forEach(function(item){
									var imgxhr = $.ajax({
										type: "GET",
										url: item,
										success: function (response) {
											fileSizeTotal = parseInt(fileSizeTotal) + parseInt(imgxhr.getResponseHeader('Content-Length'));
										},
										complete: function(){
											filesize.html( (fileSizeTotal / 1024).toFixed(2) + "kB");
										}
									});
								})
								window.banner = new Function(response.scripts)();
								handleScrubber();
							})
							fileSizeTotal = fileSizeTotal + xhr.getResponseHeader('Content-Length');
						},
						error: function (response) {
							console.error("Error in getting banner, ", response);
						}
					});
				}

				function dataFilter (response) {
					var styles = response.match(/<style data-(?:H5BANNER|anione)="styles".*?>[\s\S]*?<\/style>/ig)[0];
					var href_styles_match = response.match(/<link.*href="([\s\S]*?)".*?>/ig);
					var href_styles = "";
					var scripts_regex = /<script data-(?:H5BANNER|anione)="scripts".*?>([\s\S]*?)<\/script>/ig;
					var scripts = scripts_regex.exec(response)[1];
					// Wrap the banner IIFE so new Function(...)() returns the timeline for GSDevTools.
					// Supports same-line and next-line comments (prettier often moves them).
					// Matches both H5BANNER and legacy ANIONE tokens.
					scripts = scripts.replace(
						/\(function\s*\(\s*\)\s*\{\s*(\/\/\s*(?:H5BANNER|ANIONE):\s*main timeline function)?/,
						"return (function() { // H5BANNER: main timeline function"
					);
					// Classic banners chain everything off `tl // H5BANNER...` (or ANIONE) and need an early return.
					// Modular banners already `return tl` at the end — skip the early return so module
					// setup code still runs in the preview tool.
					if (!/\breturn\s+tl\b/.test(scripts)) {
						scripts = scripts.replace(
							/(\btl)\b(?=[^;]*\/\/\s*(?:H5BANNER|ANIONE):\s*main timeline)/,
							"return $1"
						);
					}
					var src_scripts_regex = /<script src="([\s\S]*?)"><\/script>/ig;
					var src_scripts = [];
					var markup = response.match(/<a data-(?:H5BANNER|anione)="markup".*?>[\s\S]*?<\/a>/ig)[0];
					markup = markup.replace(/\.\.\/assets\//ig, "assets/");

					var a_src;
					while (a_src = src_scripts_regex.exec(response)) {
						src_scripts.push(a_src[1])
					}

					if (href_styles_match) {
						for (var i = 0; i <= href_styles_match.length; i++) {
							var style = href_styles_match[i];
							if (style) {
								href_styles += style;
							}
						}
					}

					return {
						styles: styles,
						scripts: scripts,
						markup: markup,
						src_scripts: src_scripts,
						href_styles: href_styles,
					};
				}

				function handleScrubber () {
					if (window.banner) {
						// Recreate GSDevTools with the banner timeline. Calling .animation() on the
						// existing instance races with GSDevTools' deferred init and often leaves
						// the scrubber stuck on Global Timeline at 0.00/0.00.
						createScrubber(window.banner);
						window.banner.play(0);
					}
				}
			});
